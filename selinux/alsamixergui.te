require {
	type alsamixergui_t;
	type xserver_t;
	type sound_device_t;
	type xfce4_task_manager_t;
	class chr_file { ioctl open read write };
	class shm { unix_read unix_write };
	class process sigkill;
}

allow alsamixergui_t sound_device_t:chr_file { ioctl open read write };
